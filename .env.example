# 伺服器
PORT=3000
ADMIN_TOKEN=change-me-to-a-long-random-string

# ------------------------------------------------------------------
# 4 個 LINE 官方帳號（頻道）設定
# 每個頻道對應一個新聞分類，各自可加入不同的房仲/建設/投資群組
#   BOT_A -> 分類 A：土地利用 / 政府法規
#   BOT_B -> 分類 B：建築營造 / 市場觀察
#   BOT_C -> 分類 C：房地產應用（AI, ESG, 綠建築）
#   BOT_D -> 分類 D：法規、稅務、政策、補助
# 每組值都可在 LINE Developers Console > Messaging API 頁籤取得
# ------------------------------------------------------------------

LINE_BOT_A_NAME=土地法規小助理
LINE_BOT_A_CHANNEL_ACCESS_TOKEN=
LINE_BOT_A_CHANNEL_SECRET=

LINE_BOT_B_NAME=建築市場小助理
LINE_BOT_B_CHANNEL_ACCESS_TOKEN=
LINE_BOT_B_CHANNEL_SECRET=

LINE_BOT_C_NAME=房地產科技小助理
LINE_BOT_C_CHANNEL_ACCESS_TOKEN=
LINE_BOT_C_CHANNEL_SECRET=

LINE_BOT_D_NAME=稅務政策小助理
LINE_BOT_D_CHANNEL_ACCESS_TOKEN=
LINE_BOT_D_CHANNEL_SECRET=

# ------------------------------------------------------------------
# 買方客需媒合看板：刊登前手機驗證用的簡訊發送
# 未設定 SMS_WEBHOOK_URL 時，驗證碼只會記錄在伺服器 log，
# 且 /api/verify/send 會直接回傳驗證碼供本機測試（見 buyer-board.html）。
# 正式上線請設定 SMS_WEBHOOK_URL 指向你使用的簡訊閘道（三竹、簡訊王等）
# 的 HTTP 端點，系統會 POST { phone, code, message } 過去。
# ------------------------------------------------------------------
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
